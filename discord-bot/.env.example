# Never commit the real values. Keep this file as a template only.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Set for immediate guild-only slash command registration during development.
DISCORD_GUILD_ID=

# LEGACY-X Root API. Public commands do not need a token. Keep any bot service
# token server-side and add only after dedicated bot endpoints are provisioned.
LEGACYX_API_URL=https://api.legacyx.cc
LEGACYX_BOT_API_TOKEN=

# Discord IDs, not names. Comma-separated staff role IDs permitted to use /staff.
DISCORD_STAFF_ROLE_IDS=
DISCORD_REPORT_CHANNEL_ID=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
