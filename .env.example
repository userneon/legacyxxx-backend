SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STEAM_WEB_API_KEY=
JWT_SECRET=
PUBLIC_API_ORIGIN=
STATIC_ASSET_BASE_URL=https://static.legacyx.cc
# Steam-d haragddag relying-party domain. Callback-iig Nginx legacyx.cc -> Root API proxy-oor damjuulna.
STEAM_OPENID_ORIGIN=https://legacyx.cc
# Share HTTPS-only login sessions between the public site and Root API subdomain.
AUTH_COOKIE_DOMAIN=.legacyx.cc
FRONTEND_ORIGIN=
# The staff site (owner request 2026-10-23): https://admin.legacyx.cc. It may call the API and sign in with Steam (login returns there). Leave empty to keep staff on the main site.
ADMIN_ORIGIN=
POST_LOGIN_REDIRECT=
# API security controls. Keep API behind exactly one trusted Nginx proxy unless TRUST_PROXY is explicitly changed.
TRUST_PROXY=1
API_RATE_LIMIT_MAX=120
API_AUTH_RATE_LIMIT_MAX=30
API_SENSITIVE_RATE_LIMIT_MAX=45
API_BODY_LIMIT_KB=1024
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Optional override for the operator-only CS2 catalog ingest source.
SKINCHANGER_CATALOG_SOURCE_BASE=https://bymykel.github.io/CSGO-API/api/en

# Linking Discord from the website (Discord developer portal → your application → OAuth2).
# The redirect must be registered there exactly: https://api.legacyx.cc/api/v1/auth/discord/callback
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://api.legacyx.cc/api/v1/auth/discord/callback

# Player checks: the signed checker program players download (a zip made per check, with the check's code inside).
# Leave empty to turn the personal download off.
# The installer (.msi) is preferred: players type the code. Without it the exe + rules zip with the code inside is sent.
# Optional JSON file with the checker rules (what it looks for, the points and the limits). Kept on the server only; without it the built-in rules are used.
CHECKER_SERVER_RULES_PATH=
# on = a finished check bans the player (and the accounts on the same PC) when it found a cheat or the PC belongs to a banned account. Off until you have seen real results.
CHECK_AUTO_BAN=off
CHECKER_MSI_PATH=
# Optional own address for the download, e.g. https://checker.legacyx.cc: staff then get https://checker.legacyx.cc/K7F2-9QX4 instead of an api.legacyx.cc link (Nginx block in VPS_DEPLOY.md).
CHECKER_DOWNLOAD_ORIGIN=
CHECKER_EXE_PATH=
CHECKER_RULES_PATH=

# The game host, for Staff -> Host (owner request 2026-11-07). Leave empty to turn it off. Set up with docs/HOST_ACCESS.md:
# the key is a FILE (never paste it into a table or chat), and its authorized_keys line forces one script on the host.
HOST_SSH_HOST=
# Several hosts (the web VPS and each game VPS) as JSON; replaces HOST_SSH_HOST. kind is "web" (ops/legacyx-web.sh) or "game" (legacyxxx-plugins/scripts/legacyx-host.sh).
# HOST_SSH_HOSTS=[{"id":"web","kind":"web","label":"Web","host":"127.0.0.1"},{"id":"game1","kind":"game","label":"Game 1","host":"203.0.113.20"}]
HOST_SSH_HOSTS=
HOST_SSH_USER=root
HOST_SSH_PORT=22
HOST_SSH_KEY=
# Optional: a known_hosts file with the host's key; with it ssh refuses a host that changes.
HOST_SSH_KNOWN_HOSTS=
