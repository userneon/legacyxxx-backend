# LEGACY-X AdminPlus production API. Copy to .env and replace every placeholder.
# This service is API-only: it does not serve a dashboard or static frontend.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=1
ADMINPLUS_RATE_LIMIT=120
PLUGIN_RATE_LIMIT=60

# CS2 server RCON. Never expose RCON directly to the public internet.
RCON_HOST=your-cs2-private-host
RCON_PORT=27015
RCON_PASSWORD=replace_with_a_long_rcon_password

# Operator API secret. At least 32 random characters in production.
API_SECRET=replace_with_at_least_32_random_characters

# MatchZy server-to-server ingestion secret. This must differ from API_SECRET.
PLUGIN_INGEST_SECRET=replace_with_a_second_at_least_32_random_character_secret
LEGACYX_DEFAULT_SEASON=season-1

# LEGACY-X server-only Supabase credentials. These are never sent to a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
LEGACYX_DB_SCHEMA=legacy_x
LEGACYX_AUDIT_TABLE=adminplus_audit_logs
LEGACYX_AUDIT_ENABLED=true
LEGACYX_AUDIT_INCLUDE_COMMANDS=false
ADMINPLUS_INSTANCE_ID=legacy-x-adminplus-01

# Optional Discord admin-action notifications. Keep disabled until the webhook is created.
DISCORD_WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/id-and-token

# Keep false unless a tightly controlled break-glass workflow is approved.
ALLOW_RAW_RCON=false

# Optional maps and mounted server maps directories.
ADMINPLUS_MAPS=de_dust2,de_mirage,workshop/123456789/example_map
ADMINPLUS_MAP_DIRS=/srv/cs2/game/csgo/maps
